# Local signing secret for CE108 access tokens. Replace in any shared environment.
CE108_APP_SECRET=replace-with-a-long-random-secret

# SQLite database path. Relative paths are resolved from the project root when using README commands.
CE108_DB_PATH=data/ce108.db
CE108_TOKEN_TTL_SECONDS=43200

# Comma-separated origins allowed to call FastAPI from browsers.
# Local default is used when this is empty.
# Example: https://ce108-mobile.example.com,https://ce108-admin.example.com
CE108_CORS_ORIGINS=

# LINE/LIFF values are optional in v0.3. Webhook signature verification is enabled when LINE_CHANNEL_SECRET is set.
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
LIFF_ID=
PUBLIC_BASE_URL=http://localhost:8000

# Note AI upload extraction.
# disabled: text files only. Photo/PDF OCR is not sent to an external provider.
NOTE_OCR_PROVIDER=disabled
NOTE_OCR_MAX_BYTES=5242880
